# Production configuration (copy to your secret manager; do not commit .env)
RESERVATION_DATABASE=/var/lib/citrine-salt/reservations.sqlite3
PORT=8000

# SMTP confirmation email
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=reservations@example.com
# RESTAURANT_EMAIL may be used as a fallback sender
